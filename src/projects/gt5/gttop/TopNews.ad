module News
{
    static sIsNewsOn = false;

    module OBS_Enum
    {
        static NEWS_OBS_SLEEP = 0;
        static NEWS_OBS_WAIT_NEWS = 1;
        static NEWS_OBS_END_NEWS = 2;
    }

    static sNewsObserver = nil;
    static sLocalArticles = [];

    function loadLocalArticles()
    {
        sLocalArticles = [];
        //mm: TODO: localisation support
        var res = main::pdistd::ReadFile("/textdata/gt5/news/news.xml");
        if (res["result"] != main::pdistd::FileError::OK)
            return;

        var xml = main::pdistd::MXml();
        xml.parse(res["buffer"]);
        var dom = xml.result;
        var nodelist = dom["NewsRoot"];
        if (nodelist == nil || nodelist.size == 0)
            return;

        var categories = nodelist[0]["Category"];
        var articles = nodelist[0]["Article"];
        if (articles == nil)
            return;

        for (var i = 0; i < articles.size; i++)
        {
            var article = articles[i];
            var cat_id1 = article.getAttribute("category_id1").toInt();
            if (cat_id1 == 20)
                continue;
            var cat_name = "";
            if (categories != nil)
            {
                for (var j = 0; j < categories.size; j++)
                {
                    if (categories[j].getAttribute("category_id1").toInt() == cat_id1)
                    {
                        cat_name = categories[j].getAttribute("name");
                        break;
                    }
                }
            }

            sLocalArticles.push([
                "news_id":       article.getAttribute("news_id"),
                "category_id1":  cat_id1,
                "category_id2":  article.getAttribute("category_id2").toInt(),
                "category_name": cat_name,
                "title":         article.getAttribute("title"),
                "headline":      article.getAttribute("headline"),
                "news_time":     nil,
            ]);
        }
    }

    method initialize()
    {
        News.visible = true;
        sNewsObserver = OBS_Enum::NEWS_OBS_SLEEP;

        tip.value = "";
        tip.action_type = 4;
    }

    method on(context)
    {
        sIsNewsOn = true;

        News.FadeActor.on_effect_end = pop_news;
        ActorUtil::ResetActors(News, false);

        News.visible = true;
    }

    method off(context)
    {
        sNewsObserver = OBS_Enum::NEWS_OBS_SLEEP;
        sIsNewsOn = false;
        tip.value = "";

        News.FadeActor.on_effect_end = function(context) { News.visible = false; };
        ActorUtil::ResetActors(News, true);
    }

    method pop_news(context)
    {
        if (Grim2.isOutOfService())
        {
            tip.value = context.translate(ROOT, "Network", "GT5_OUT_OF_SERVICE");
            return;
        }

        if (!LoginUtil::isOnline())
        {
            if (sLocalArticles.size == 0)
                loadLocalArticles();

            if (sLocalArticles.size == 0)
                return;

            var news = sLocalArticles.shift();
            tip.value = context.translate(context.getRootWindow(), "News", "SCROLL_NEWS_FORMAT")
                .build(news["category_name"], news["title"], news["headline"]);
            return;
        }

        var news_id = ScrollNewsUtil::pop(context);
        if (news_id == "")
            return;

        var me = self;

        News2.requestNews(news_id, function (args)
        {
            |var context, var request| = args;
            if (request.isDone())
            {
                var news = News2.decodeNews(request);
                if (ScrollNewsUtil::isInvalidNews(context, news, true))
                {
                    if (!ScrollNewsUtil::isEmpty())
                        context.pushEvent(menu::MScriptEvent(context, me, "pop_news"));
                }
                else
                {
                    tip.value = context.translate(context.getRootWindow(), "News", "SCROLL_NEWS_FORMAT")
                        .build(NewsFileUtil::getCategoryName(news["category_id1"], news["category_id2"], 0), news["title"], news["headline"]);
                }
            }
            else
            {
                context.pushEvent(menu::MScriptEvent(context, me, "pop_news"));
            }
        });
    }

    method isInvalidNews(context, news)
    {
        if (news["headline"] == "")
            return false;
    }

    method next_news(context) { }
    method previous_news(context) { }
    method first_news(context) { }
    method last_news(context) { }

    module tip
    {
        function onInitialize()
        {
            tip.remove();
            tip.value = "";
        }

        function onPhase10End(context)
        {
            if (tip.value == "")
                return;

            News.next_news(context);
        }

        function onPhase12End(context)
        {
            if (tip.value == "")
                return;

            if (sNewsObserver == OBS_Enum::NEWS_OBS_WAIT_NEWS)
            {
                sNewsObserver = OBS_Enum::NEWS_OBS_END_NEWS;
                tip.value = "";
                return;
            }

            tip.value = "";
            News.pop_news(context);
        }
    }
}